# Variáveis de Configuração do Google Cloud
GCP_PROJECT_ID=seu-projeto-gcp-aqui
GCP_REGION=southamerica-east1
GCS_BUCKET_NAME=seu-bucket-bronze-aqui

# Autenticação (opcional se já tiver executado 'gcloud auth application-default login')
# GOOGLE_APPLICATION_CREDENTIALS=caminho/para/service_account.json

# Nomes dos Datasets no BigQuery
BQ_DATASET_BRONZE=ecommerce_bronze
BQ_DATASET_SILVER=ecommerce_silver
BQ_DATASET_GOLD=ecommerce_gold
